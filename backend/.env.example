# FastAPI server
HOST=0.0.0.0
PORT=8000

# MySQL database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=health_assistant
MYSQL_USER=root
MYSQL_PASSWORD=

# Auth
# Use a long random value in every non-local environment.
JWT_SECRET=replace-with-a-long-random-secret

# Google Gemini
# Required for chat, prescription OCR/analysis, AI insights, reports, and cost refinement.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
